# Maintainer: stshow <33067247+stshow@users.noreply.github.com>
#
# The Arch package of Lodi (AGENTS.md §9.3). It installs the release's own static musl
# binary — the asset the release build makes from a clean checkout — so the packaged file
# is bit-for-bit the binary asset of the same release and no compiler runs here.
#
# The release build reads pkgname, pkgver, pkgrel, pkgdesc and license from this file and
# refuses to build when pkgver is not Cargo.toml's [package].version, so the built
# lodi-<pkgver>-<pkgrel>-<arch>.pkg.tar.zst and this description cannot drift apart.
#
# To build it with makepkg instead, put the matching asset beside this file:
#   makepkg -g   # after downloading lodi-<pkgver>-<arch>-linux-musl into this directory
#
# aarch64 is cross-built on the x86_64 builder and is not tested by this project (§9.3a).
pkgname=lodi
pkgver=1.12.2
pkgrel=1
pkgdesc="Environment and system manager for Ubuntu, Debian, Arch and Fedora"
arch=('x86_64' 'aarch64')
url='https://github.com/stshow/lodi'
license=('GPL-3.0-or-later')
depends=()
makedepends=()
options=('!strip' '!debug')
source=("copyright")
source_x86_64=("lodi-$pkgver-x86_64-linux-musl")
source_aarch64=("lodi-$pkgver-aarch64-linux-musl")
# The assets are checked against the release's own SHA256SUMS, which is the integrity
# statement for every asset (§9.3: the assets are not signed).
sha256sums=('SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

# The package contains /usr/bin/lodi and the copyright file. GPL-3.0-or-later's own text is one
# of the common licenses Arch ships (/usr/share/licenses/common/GPL3), so the full licence text
# is not duplicated here; the installed copyright file is the committed packaging/copyright,
# which states the grant and carries every third-party notice the static binary owes
# (docs/licenses/DEPENDENCIES.md). The release build installs the same two files.
package() {
	install -Dm755 "$srcdir/lodi-$pkgver-$CARCH-linux-musl" "$pkgdir/usr/bin/lodi"
	install -Dm644 "$srcdir/copyright" "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
